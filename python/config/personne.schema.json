    "MotCle": {
      "description": "Mot important écrit par la personne, qu'il figure ou non dans un lexique.",
      "properties": {
        "mot": {
          "title": "Mot",
          "type": "string"
        },
        "origine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "id_question de la réponse d'où vient le mot (ex. q_comment_ca_va)",
          "title": "Origine"
        },
