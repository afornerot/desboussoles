{
  "$schema": "./questions.schema.json",
  "questions": [
    {
      "id_question": "q_comment_ca_va",
      "type": "textarea",
      "texte": "Comment ça va ?",
      "mandatory": true
    },
    {
      "id_question": "q_age",
      "type": "choice",
      "champ": "age",
      "texte": "Quel âge a la personne concernée ? (vous pouvez aussi taper l'âge)",
      "mandatory": true,
      "options": [
        {"valeur": "0-2", "libelle": "0-2 ans"},
        {"valeur": "3-6", "libelle": "3-6 ans"},
        {"valeur": "7-12", "libelle": "7-12 ans"},
        {"valeur": "13-17", "libelle": "13-17 ans"},
        {"valeur": "18-25", "libelle": "18-25 ans"},
        {"valeur": "26-64", "libelle": "26-64 ans"},
        {"valeur": "65+", "libelle": "65 ans et plus"}
      ]
    },
    {
      "id_question": "q_commune",
      "type": "commune",
      "champ": "commune",
      "texte": "Dans quelle commune habitez-vous (ou la personne concernée) ? Le code postal suffit.",
      "mandatory": true
    },
    {
      "id_question": "q_switch",
      "type": "choice",
      "texte": "Voulez-vous continuer le questionnaire ou passer à un chatbot ?",
      "mandatory": true,
      "options": [
        {"valeur": "oui", "libelle": "Passer au chatbot"},
        {"valeur": "non", "libelle": "Continuer le questionnaire"}
      ]
    },
    {
      "id_question": "q_demandeur",
      "type": "choice",
      "champ": "demandeur",
      "texte": "Vous écrivez pour…",
      "mandatory": true,
      "options": [
        {"valeur": "soi", "libelle": "vous-même"},
        {"valeur": "proche", "libelle": "un proche"},
        {"valeur": "professionnel", "libelle": "en tant que professionnel"}
      ]
    },
    {
      "id_question": "q_parcours",
      "type": "choice",
      "champ": "parcours",
      "texte": "Qu'est-ce qui vous aiderait le plus ?",
      "mandatory": true,
      "options": [
        {"valeur": "ecoute_soutien", "libelle": "parler à quelqu'un"},
        {"valeur": "humeur_depression", "libelle": "je me sens mal, déprimé(e)"},
        {"valeur": "soins_ambulatoires", "libelle": "un soin, voir un psy"},
        {"valeur": "addiction", "libelle": "alcool, drogues, jeux, écrans"},
        {"valeur": "victimologie_vif", "libelle": "violences"},
        {"valeur": "enfant_adolescent", "libelle": "un enfant ou un ado"},
        {"valeur": "perinatalite", "libelle": "grossesse, bébé"},
        {"valeur": "hebergement", "libelle": "une solution d'hébergement"},
        {"valeur": "social", "libelle": "une aide sociale ou administrative"},
        {"valeur": "adulte_general", "libelle": "autre chose"}
      ]
    },
    {
      "id_question": "q_quartier",
      "type": "choice",
      "champ": "quartier",
      "texte": "Dans quel quartier de Besançon ?",
      "mandatory": true
    },
    {
      "id_question": "q_chose_a_rajouter",
      "type": "textarea",
      "texte": "Une chose à rajouter ?",
      "mandatory": false
    }
  ]
}
