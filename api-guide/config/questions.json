{
  "$schema": "./questions.schema.json",
  "questions": [
    {
      "id_question": "q_age",
      "type": "texte",
      "champ": "age",
      "texte": "Quel âge a la personne concernée ? (en années)",
      "mandatory": true
    },
    {
      "id_question": "q_adresse",
      "type": "adresse",
      "champ": "commune",
      "texte": "Quelle est votre adresse ?",
      "texte_tiers": "Quelle est l'adresse de la personne concernée ?",
      "mandatory": true
    },
    {
      "id_question": "q_pour_qui",
      "type": "choice",
      "champ": "demandeur",
      "texte": "Pour qui cherchez-vous de l'aide ?",
      "mandatory": false,
      "options": [
        {"valeur": "soi", "libelle": "Pour moi"},
        {"valeur": "tiers", "libelle": "Pour un tiers"}
      ]
    },
    {
      "id_question": "q_duree",
      "type": "choice",
      "champ": "duree",
      "texte": "Depuis combien de temps dure la difficulté ?",
      "mandatory": false,
      "toujours": true,
      "options": [
        {"valeur": "moins_15_jours", "libelle": "Moins de 15 jours"},
        {"valeur": "moins_1_mois", "libelle": "Moins d'un mois"},
        {"valeur": "moins_6_mois", "libelle": "Moins de 6 mois"},
        {"valeur": "plus_6_mois", "libelle": "Plus de 6 mois"}
      ]
    },
    {
      "id_question": "q_impact",
      "type": "choice",
      "champ": "impact_domaine",
      "texte": "Cette situation a-t-elle un impact sur :",
      "mandatory": false,
      "toujours": true,
      "options": [
        {"valeur": "travail", "libelle": "Le travail"},
        {"valeur": "etudes", "libelle": "Les études"},
        {"valeur": "logement", "libelle": "Le logement"},
        {"valeur": "famille", "libelle": "La famille"},
        {"valeur": "relations_sociales", "libelle": "Les relations sociales"}
      ]
    },
    {
      "id_question": "q_impact_niveau",
      "type": "choice",
      "champ": "impact_niveau",
      "texte": "Niveau d'impact :",
      "mandatory": false,
      "toujours": true,
      "options": [
        {"valeur": "peu", "libelle": "Peu"},
        {"valeur": "moderement", "libelle": "Modérément"},
        {"valeur": "beaucoup", "libelle": "Beaucoup"}
      ]
    },
    {
      "id_question": "q_besoin",
      "type": "textarea",
      "texte": "Quel est votre principal besoin, ou quelle difficulté rencontrez-vous ?",
      "texte_tiers": "Quel est le principal besoin de la personne, ou quelle difficulté rencontre-t-elle ?",
      "mandatory": false
    },
    {
      "id_question": "q_accompagnement",
      "type": "choice",
      "champ": "deja_suivi",
      "texte": "Bénéficiez-vous déjà d'un accompagnement, ou en avez-vous déjà parlé à votre médecin ?",
      "texte_tiers": "La personne bénéficie-t-elle déjà d'un accompagnement, ou en a-t-elle déjà parlé à son médecin ?",
      "mandatory": false,
      "toujours": true,
      "options": [
        {"valeur": "oui", "libelle": "Oui"},
        {"valeur": "non", "libelle": "Non"}
      ]
    }
  ]
}
