{
  "$defs": {
    "SectionInfo": {
      "additionalProperties": false,
      "description": "Bloc d'informations affiché au front.",
      "properties": {
        "id": {
          "description": "identifiant unique de la section",
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "titre": {
          "minLength": 1,
          "title": "Titre",
          "type": "string"
        },
        "condition": {
          "description": "toujours · mineur (âge < 18) · tiers (la personne écrit pour quelqu'un d'autre)",
          "enum": [
            "toujours",
            "mineur",
            "tiers"
          ],
          "title": "Condition",
          "type": "string"
        },
        "elements": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Elements",
          "type": "array"
        }
      },
      "required": [
        "id",
        "titre",
        "condition",
        "elements"
      ],
      "title": "SectionInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/SectionInfo"
      },
      "title": "Sections",
      "type": "array"
    }
  },
  "required": [
    "sections"
  ],
  "title": "Section info_global (l'ordre de la liste = l'ordre d'affichage)",
  "type": "object"
}
